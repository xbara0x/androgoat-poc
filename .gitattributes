# Normalize line endings on checkin, keep native EOLs on checkout.
# Windows-only files (batch, PowerShell) stay CRLF; everything else LF.
* text=auto eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
# Never touch binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.apk  binary
*.jar  binary
